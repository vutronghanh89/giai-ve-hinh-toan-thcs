  "solutionSteps": [
    {
      "lineText": "Xét △ABC vuông tại A, áp dụng định lý Pythagore:",
      "voiceExplanation": "Để tính cạnh huyền B C, chúng ta xét tam giác vuông A B C và áp dụng định lý Pi ta go.",
      "highlightSegments": [
        "A-B",
        "A-C",
        "B-C"
      ],
      "highlightPoints": [],
      "highlightPolygons": [
        {
          "points": [
            "A",
            "B",
            "C"
          ],
          "color": "blue"
        }
      ]
    },
    {
      "lineText": "BC² = AB² + AC² = 3² + 4² = 25",
      "voiceExplanation": "Bình phương cạnh huyền bằng tổng bình phương hai cạnh góc vuông. Ta có 3 bình phương cộng 4 bình phương bằng 25.",
      "highlightSegments": [],
      "highlightPoints": [],
      "highlightPolygons": []
    },
    {
      "lineText": "⇒ BC = √25 = 5 (cm)",
      "voiceExplanation": "Suy ra B C bằng căn bậc hai của 25, tức là bằng 5 xăng ti mét.",
      "highlightSegments": [
        "B-C"
      ],
      "highlightPoints": [],
      "highlightPolygons": []
    },
    {
      "lineText": "Áp dụng hệ thức lượng: AH . BC = AB . AC",
      "voiceExplanation": "Tiếp theo, để tính đường cao A H, ta sử dụng hệ thức: tích của đường cao và cạnh huyền bằng tích của hai cạnh góc vuông.",
      "highlightSegments": [
        "A-H",
        "B-C",
        "A-B",
        "A-C"
      ],
      "highlightPoints": [],
      "highlightPolygons": []
    },
    {
      "lineText": "⇒ AH . 5 = 3 . 4 = 12",
      "voiceExplanation": "Thay các giá trị đã biết vào, ta có A H nhân 5 bằng 3 nhân 4, tức là bằng 12.",
      "highlightSegments": [],
      "highlightPoints": [],
      "highlightPolygons": []
    },
    {
      "lineText": "⇒ AH = 12 / 5 = 2,4 (cm)",
      "voiceExplanation": "Vậy đường cao A H bằng 12 chia 5, kết quả là 2 phẩy 4 xăng ti mét. Bài toán đã được giải xong rồi.",
